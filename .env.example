# Public runtime configuration for the Nuxt app.
# These values are read at runtime by Nitro, so the same image can be
# promoted across environments without rebuilding.

# Base URL of the backend API consumed by the app.
NUXT_PUBLIC_API_BASE=https://ahoma.ir/api

# Host port published by the `web` service (default profile).
APP_PORT=3000

# Number of `web` replicas. Values > 1 require the `proxy` profile.
REPLICAS=1

# Node runtime memory ceiling, tuned to the container memory limit.
NODE_OPTIONS=--max-old-space-size=384
