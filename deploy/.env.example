# Production runtime configuration for the `homacom-pori` server.
# Copy to /opt/apps/homacom/.env and adjust for the host.

# Host port published by the `web` container (container listens on 3000).
APP_PORT=4500

# Base URL of the backend API consumed by the app.
NUXT_PUBLIC_API_BASE=https://ahoma.ir/api

# Node runtime memory ceiling, tuned to the container memory limit.
NODE_OPTIONS=--max-old-space-size=384
